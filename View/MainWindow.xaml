<Window x:Class="DistributedSimulation.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Simulación del Algoritmo Ricart-Agrawala" Height="700" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Título y descripción -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="Simulación de Exclusión Mutua Distribuida" 
                       FontSize="20" FontWeight="Bold" Margin="0,0,0,5"/>
            <TextBlock Text="Implementación del algoritmo de Ricart-Agrawala usando WebSockets y Relojes de Lamport" 
                       TextWrapping="Wrap" Opacity="0.7"/>
            <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
                <Run FontWeight="SemiBold">Instrucciones:</Run>
                <LineBreak/>
                1. Seleccione un cliente usando el botón "Cambiar Cliente Activo"
                <LineBreak/>
                2. Presione "Solicitar Acceso al Recurso" para que el cliente solicite entrar en la sección crítica
                <LineBreak/>
                3. El algoritmo Ricart-Agrawala coordinará automáticamente el acceso al recurso
                <LineBreak/>
                4. Observe los mensajes y el estado del recurso para entender el funcionamiento del algoritmo
            </TextBlock>
        </StackPanel>

        <!-- Panel de estado del sistema -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#f0f0f0" CornerRadius="4" Padding="10" Margin="0,0,5,0">
                <StackPanel>
                    <TextBlock Text="Estado del Recurso Compartido" FontWeight="Bold"/>
                    <TextBlock Text="{Binding SharedResourceState}" FontSize="14" Margin="0,5,0,0" 
                             Foreground="{Binding SharedResourceState, Converter={StaticResource ResourceStateToColorConverter}}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#f0f0f0" CornerRadius="4" Padding="10" Margin="5,0,0,0">
                <StackPanel>
                    <TextBlock Text="Cliente Activo" FontWeight="Bold"/>
                    <TextBlock Text="{Binding ActiveClientId, StringFormat='Cliente {0}'}" FontSize="14" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Log de mensajes del sistema -->
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="1">
            <ScrollViewer x:Name="scrollViewer" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Messages}" Margin="5">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Panel de controles -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button Content="Solicitar Acceso al Recurso" 
                    Command="{Binding SendRequestCommand}" 
                    Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Cambiar Cliente Activo" 
                    Command="{Binding ChangeClientCommand}" 
                    Padding="10,5" Margin="0,0,10,0"/>
            <Button Content="Reiniciar Sistema" 
                    Command="{Binding ResetCommand}" 
                    Padding="10,5"/>
        </StackPanel>
    </Grid>
</Window>